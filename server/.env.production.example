# Production env for the CaterKart celebrations backend.
# Copy to .env.production on the server and fill in. Never commit the real file.

NODE_ENV=production
PORT=4000

# Frontend origin. CORS in main.ts reflects this exact value (credentialed
# requests reject a wildcard), and the OAuth callback bounces the browser here.
WEB_ORIGIN=https://caterkart.in

# ── Datastores ──────────────────────────────────────────────────────────────
# Used by docker-compose.prod.yml to build DATABASE_URL and the db container.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
# DATABASE_URL and REDIS_URL are injected by compose — do not set them here.

# ── Queues ──────────────────────────────────────────────────────────────────
# Must be true. Placement is scheduled as delayed BullMQ jobs; with queues off
# nothing ever places. Compose sets this too; kept here as documentation.
ENABLE_QUEUES=true

# ── Swiggy MCP ──────────────────────────────────────────────────────────────
MCP_BASE_URL=https://mcp.swiggy.com
MCP_FOOD_PATH=/food
MCP_INSTAMART_PATH=/im
MCP_DINEOUT_PATH=/dineout
MCP_OAUTH_SCOPE=mcp:tools

# This exact string is what gets registered with Swiggy (builders@swiggy.in).
# The path is bare — main.ts excludes the callback from the global /api prefix.
MCP_OAUTH_REDIRECT_URI=https://api.caterkart.in/auth/swiggy/callback

# ── Secrets — generate with: openssl rand -hex 32 ───────────────────────────
# Encrypts Swiggy access tokens at rest (AES-256-GCM, CryptoService).
TOKEN_ENC_KEY=CHANGE_ME_64_HEX_CHARS
# Signs invite tokens and app session cookies.
APP_JWT_SECRET=CHANGE_ME_64_HEX_CHARS

# ── Orchestration tuning ────────────────────────────────────────────────────
FOOD_ORDER_CAP_RUPEES=1000
TRACKING_POLL_MIN_MS=10000
CONVERGENCE_TOLERANCE_MIN=5
PREDROP_LEAD_MIN=15
